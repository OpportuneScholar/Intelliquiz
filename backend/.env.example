PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/intelliquiz?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5000
# Leave RESEND_API_KEY empty in development: OTP emails are printed in the server console instead.
# In production (NODE_ENV=production) a real key + verified MAIL_FROM sender are required.
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=IntelliQuiz <onboarding@resend.dev>
