PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/intelliquiz
PGSSL=false
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5000
TEACHER_NAME=IntelliQuiz Teacher
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=ChangeThisToALongPassword123!

# SMTP settings for teacher email OTP verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=IntelliQuiz <your-sender@gmail.com>
