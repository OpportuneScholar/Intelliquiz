{
  "name": "intelliquiz-backend",
  "version": "2.0.0",
  "private": true,
  "description": "SQL/PostgreSQL REST API for IntelliQuiz",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:teacher": "node scripts/seedTeacher.js",
    "check": "node --check server.js && node --check routes/auth.js && node --check routes/teacherRegistration.js && node --check routes/questions.js && node --check middleware/auth.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
